      "panel-25": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "aeke3o5ypjklcb"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "app": "grafana-assistant-app",
                        "query": "from(bucket: \"bucketakke\") |\u003e \nrange(start: v.timeRangeStart, stop: v.timeRangeStop) |\u003e \nfilter(fn: (r) =\u003e (r.host =~ /$host/ or \"$host\" == \".*\") and r.instance == ${instance}) |\u003e \nfilter(fn: (r) =\u003e r._measurement == \"jvm.class-loading.loaded\") |\u003e \nlast()",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "filterFieldsByName",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "exclude": {
                        "pattern": "^p\\d"
                      }
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": ".*instance=\"([^@]+)@.*",
                      "renamePattern": "$1"
                    }
                  }
                }
              ]
            }
          },
          "description": "Current number of classes loaded in the JVM.",
          "id": 25,
          "links": [],
          "title": "Loaded classes count",
